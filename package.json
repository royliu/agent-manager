{
  "name": "agent-manager",
  "version": "0.8.0",
  "description": "Run multiple Claude Code / Codex subscriptions on one machine, and run a swarm of agents on them: a named General Manager per project, a task board, four task agents.",
  "type": "module",
  "bin": {
    "am": "./bin/am.js",
    "agent-manager": "./bin/am.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.tsx",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "multi-account",
    "profiles",
    "cli",
    "usage"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "ink": "^5.1.0",
    "picocolors": "^1.1.1",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
